"""
Lyria music generation.

Models (Oct 2026, ai.google.dev/gemini-api/docs/music-generation):
  lyria-3.5             stable, full-length songs (a couple of minutes, length steered by prompt), MP3/WAV
  lyria-3-clip-preview  always 30 s clips, MP3; good for iterating on prompts
  lyria-3-pro-preview   deprecated, replaced by lyria-3.5

Primary path: Gemini Developer API (GOOGLE_API_KEY) via the Interactions API
(client.interactions.create), which is how Google documents Lyria 3.5.
Fallback path: Vertex (GOOGLE_CLOUD_PROJECT, location global) via generate_content,
kept for setups without an API key. Whether lyria-3.5 is enabled on a given Vertex
project is not guaranteed; a 404 there is reported as an error, not masked.

Legacy Lyria 1/2/3-preview names are accepted as aliases.
"""

from __future__ import annotations

import asyncio
import base64
import logging
import os
from datetime import datetime
from pathlib import Path
from typing import Any

logger = logging.getLogger(__name__)

try:
    from google import genai
    from google.genai import types as genai_types

    GENAI_AVAILABLE = True
except ImportError:
    GENAI_AVAILABLE = False
    genai = None  # type: ignore[assignment]
    genai_types = None  # type: ignore[assignment]
    logger.warning("google-genai not installed - Lyria unavailable")

LYRIA35 = "lyria-3.5"
LYRIA3_CLIP = "lyria-3-clip-preview"
DEFAULT_LYRIA_MODEL = LYRIA35

_CANONICAL_MODELS = frozenset({LYRIA35, LYRIA3_CLIP})

# alias (lowercase) -> current model id
_LYRIA_ALIASES: dict[str, str] = {
    "lyria": LYRIA35,
    "lyria-3.5": LYRIA35,
    "lyria-35": LYRIA35,
    "lyria-clip": LYRIA3_CLIP,
    "lyria-3-clip": LYRIA3_CLIP,
    # Lyria 3 Pro preview is deprecated in favour of 3.5
    "lyria-3": LYRIA35,
    "lyria-3-pro": LYRIA35,
    "lyria-3-pro-preview": LYRIA35,
    # Older product / UI names
    "lyria-2": LYRIA35,
    "lyria-002": LYRIA35,
    "lyria-2.0-music-generation": LYRIA35,
    "lyria-1.0-music-generation": LYRIA3_CLIP,
    "music-lyra-1.1": LYRIA35,
    "lyria-en-001": LYRIA35,
    "musicfx": LYRIA35,
    "lyria-realtime": LYRIA3_CLIP,
}

LYRIA_MODELS: dict[str, str] = {
    LYRIA35: "Lyria 3.5 - full-length songs (stable, default)",
    LYRIA3_CLIP: "Lyria 3 Clip - fixed 30s clips (preview)",
    "lyria-3": "Legacy alias -> Lyria 3.5",
    "lyria-3-pro-preview": "Deprecated -> Lyria 3.5",
    "lyria-2": "Legacy alias -> Lyria 3.5",
    "lyria-002": "Legacy API id -> Lyria 3.5",
    "lyria-realtime": "Legacy alias -> Lyria 3 Clip",
}


def _resolve_model_key(model: str) -> str:
    m = model.strip().lower()
    if m in _CANONICAL_MODELS:
        return m
    return _LYRIA_ALIASES.get(m, model.strip())


class LyriaClient:
    """Lyria via the Gemini API Interactions endpoint, with a Vertex fallback."""

    def __init__(self, api_key: str | None = None, project_id: str | None = None):
        self.api_key = (api_key or os.getenv("GOOGLE_API_KEY") or "").strip()
        self.project_id = (project_id or os.getenv("GOOGLE_CLOUD_PROJECT") or "").strip()
        self.mock_mode = False
        self.reason = "live"
        self.last_error: str | None = None
        self.backend: str = "none"
        self._genai_client: Any = None

        if not GENAI_AVAILABLE:
            self.mock_mode = True
            self.reason = "dependency_missing"
            return

        try:
            if self.api_key:
                self._genai_client = genai.Client(api_key=self.api_key)
                self.backend = "gemini_api"
                logger.info("Lyria: Gemini API client (Interactions) initialised.")
            elif self.project_id:
                self._genai_client = genai.Client(vertexai=True, project=self.project_id, location="global")
                self.backend = "vertex"
                logger.info("Lyria: Vertex client initialised (location=global, fallback path).")
            else:
                self.mock_mode = True
                self.reason = "not_configured"
                logger.warning("Lyria needs GOOGLE_API_KEY (preferred) or GOOGLE_CLOUD_PROJECT.")
        except Exception as exc:
            self._genai_client = None
            self.mock_mode = True
            self.reason = "init_failed"
            self.last_error = str(exc)
            logger.error(f"Lyria client init failed: {exc}", exc_info=True)

    def validate_prompt(self, prompt: str) -> dict[str, Any]:
        if not prompt or not prompt.strip():
            return {"valid": False, "error": "Prompt cannot be empty"}
        if len(prompt) > 8000:
            return {"valid": False, "error": "Prompt too long (max 8000 characters)"}
        return {"valid": True}

    def get_available_models(self) -> dict[str, str]:
        return dict(LYRIA_MODELS)

    def _duration_bounds(self, model_id: str) -> tuple[int, int]:
        if model_id == LYRIA3_CLIP:
            return 30, 30
        return 10, 300

    @staticmethod
    def _audio_from_interaction(interaction: Any) -> tuple[bytes | None, str, str | None]:
        audio = getattr(interaction, "output_audio", None)
        lyrics = getattr(interaction, "output_text", None)
        if audio is None or not getattr(audio, "data", None):
            return None, "audio/mpeg", lyrics
        data = audio.data
        raw = base64.b64decode(data) if isinstance(data, str) else bytes(data)
        return raw, getattr(audio, "mime_type", None) or "audio/mpeg", lyrics

    @staticmethod
    def _audio_from_content_response(response: Any) -> tuple[bytes | None, str, str | None]:
        parts: list[Any] = []
        if getattr(response, "parts", None):
            parts.extend(response.parts)
        for c in getattr(response, "candidates", None) or []:
            content = getattr(c, "content", None)
            if content and getattr(content, "parts", None):
                parts.extend(content.parts)
        text_bits = [p.text for p in parts if getattr(p, "text", None)]
        for part in parts:
            inline = getattr(part, "inline_data", None)
            if inline and getattr(inline, "data", None) is not None:
                raw = inline.data
                data = base64.b64decode(raw) if isinstance(raw, str) else bytes(raw)
                return data, getattr(inline, "mime_type", None) or "audio/mpeg", "\n".join(text_bits) or None
        return None, "audio/mpeg", "\n".join(text_bits) or None

    async def generate_music(
        self,
        prompt: str,
        model: str = DEFAULT_LYRIA_MODEL,
        duration: int = 30,
        output_path: str | None = None,
        num_tracks: int = 1,
        temperature: float = 1.0,
        wav: bool = False,
    ) -> dict[str, Any]:
        _ = temperature  # not supported by Lyria 3.x; kept for call-site compatibility

        validation = self.validate_prompt(prompt)
        if not validation["valid"]:
            return {"success": False, "error": validation["error"]}
        if num_tracks < 1 or num_tracks > 4:
            return {"success": False, "error": "Number of tracks must be between 1 and 4."}

        requested = model.strip()
        actual_model = _resolve_model_key(model)
        dmin, dmax = self._duration_bounds(actual_model)
        if actual_model == LYRIA3_CLIP:
            duration = 30  # fixed by the model
        elif duration < dmin or duration > dmax:
            return {"success": False, "error": f"Duration must be between {dmin} and {dmax} seconds for {actual_model}."}

        if self.mock_mode or not self._genai_client:
            return await self._mock_generate_music(prompt, actual_model, duration, output_path, num_tracks)

        output_dir = Path(output_path or "outputs/music")
        output_dir.mkdir(parents=True, exist_ok=True)

        enhanced_prompt = prompt
        if actual_model != LYRIA3_CLIP:
            enhanced_prompt = f"{prompt}\n\n(Target length: about {duration} seconds.)"

        def _call() -> tuple[bytes | None, str, str | None]:
            if self.backend == "gemini_api":
                kwargs: dict[str, Any] = {"model": actual_model, "input": enhanced_prompt}
                if wav and actual_model == LYRIA35:
                    kwargs["response_format"] = {"type": "audio"}
                return self._audio_from_interaction(self._genai_client.interactions.create(**kwargs))
            response = self._genai_client.models.generate_content(
                model=actual_model,
                contents=enhanced_prompt,
                config=genai_types.GenerateContentConfig(response_modalities=["AUDIO", "TEXT"]),
            )
            return self._audio_from_content_response(response)

        tracks: list[dict[str, Any]] = []
        try:
            for idx in range(num_tracks):
                audio_bytes, mime, lyrics = await asyncio.to_thread(_call)
                if not audio_bytes:
                    return {
                        "success": False,
                        "error": "No audio in model response. Check model access and prompt safety filters.",
                        "tracks": tracks,
                    }
                ext = ".wav" if "wav" in mime else ".mp3" if ("mpeg" in mime or "mp3" in mime) else ".bin"
                filename = f"lyria_{datetime.utcnow().strftime('%Y%m%d_%H%M%S')}_{idx}{ext}"
                track_path = output_dir / filename
                track_path.write_bytes(audio_bytes)
                track: dict[str, Any] = {
                    "id": f"track-{idx}",
                    "url": str(track_path),
                    "local_path": str(track_path),
                    "filename": filename,
                    "mime": mime,
                    "status": "completed",
                }
                if lyrics:
                    track["lyrics"] = lyrics
                tracks.append(track)
        except Exception as api_error:
            return self._format_error(api_error)

        return {
            "success": True,
            "tracks": tracks,
            "metadata": {
                "model": actual_model,
                "requested_model": requested,
                "prompt": prompt,
                "duration": duration,
                "num_tracks": len(tracks),
                "generated_at": datetime.utcnow().isoformat(),
                "api": "gemini_interactions" if self.backend == "gemini_api" else "vertex_generate_content",
            },
            "mock_mode": False,
        }

    def _format_error(self, api_error: BaseException) -> dict[str, Any]:
        err = str(api_error)
        low = err.lower()
        if "not found" in low or "404" in err:
            user_message = (
                "Lyria model not found. With GOOGLE_API_KEY use lyria-3.5 or lyria-3-clip-preview; "
                "on the Vertex fallback the model may not be enabled for this project."
            )
        elif "permission" in low or "403" in err:
            user_message = "Permission denied for Lyria (check API key tier or Vertex IAM roles)."
        elif "quota" in low or "429" in err:
            user_message = "Rate limited: music generation quota exceeded."
        else:
            user_message = f"Music generation failed: {err}"
        self.last_error = err
        logger.error(f"Lyria API error: {api_error}", exc_info=True)
        return {"success": False, "error": user_message, "raw_error": err}

    async def _mock_generate_music(
        self,
        prompt: str,
        model: str,
        duration: int,
        output_path: str | None,
        num_tracks: int,
    ) -> dict[str, Any]:
        await asyncio.sleep(0.3)
        output_dir = Path(output_path or "mock/music")
        output_dir.mkdir(parents=True, exist_ok=True)

        tracks = []
        for i in range(num_tracks):
            filename = f"mock_lyria_{datetime.utcnow().strftime('%Y%m%d_%H%M%S')}_{i}.txt"
            track_path = output_dir / filename
            track_path.write_text(
                f"Mock audio placeholder (NOT real audio)\nModel: {model}\nPrompt: {prompt}\nDuration: {duration}s\n"
                f"Set GOOGLE_API_KEY (preferred) or GOOGLE_CLOUD_PROJECT for real Lyria output.\n"
            )
            tracks.append(
                {
                    "id": f"mock-{i}",
                    "url": str(track_path),
                    "local_path": str(track_path),
                    "filename": filename,
                    "status": "completed",
                }
            )

        return {
            "success": True,
            "tracks": tracks,
            "metadata": {
                "model": model,
                "prompt": prompt,
                "duration": duration,
                "num_tracks": len(tracks),
                "generated_at": datetime.utcnow().isoformat(),
                "api": "mock",
            },
            "mock_mode": True,
            "message": f"Running in mock mode. Reason: {self.reason}",
        }

    def get_status(self) -> dict[str, Any]:
        if self.mock_mode:
            messages = {
                "not_configured": "Set GOOGLE_API_KEY (preferred) or GOOGLE_CLOUD_PROJECT for Lyria.",
                "dependency_missing": "Install google-genai>=2.6 (required for Lyria).",
                "init_failed": f"Init failed: {self.last_error}",
            }
            message = messages.get(self.reason, "Running in mock mode.")
        elif self.backend == "gemini_api":
            message = "Lyria ready (Gemini API, Interactions)."
        else:
            message = "Lyria ready on Vertex fallback (location global); lyria-3.5 availability depends on the project."

        return {
            "api_key_configured": bool(self.api_key),
            "project_id_configured": bool(self.project_id),
            "backend": self.backend,
            "mock_mode": self.mock_mode,
            "available_models": self.get_available_models(),
            "reason": self.reason,
            "message": message,
            "settings_url": "/settings",
        }


def create_lyria_client(api_key: str | None = None, project_id: str | None = None) -> LyriaClient:
    return LyriaClient(api_key, project_id)
